extends RefCounted
## Runtime-built scenery art for the Willowmere visual uplift.
## The approved pixel assets are embedded as text-safe PNG payloads so GitHub
## connector writes cannot corrupt binary art.

const ATLAS_PNG := ""
const PROPS_PNG := ""

static func _texture_from_b64(data: String, label: String) -> Texture2D:
	var raw := Marshalls.base64_to_raw(data)
	var image := Image.new()
	var err := image.load_png_from_buffer(raw)
	if err != OK:
		push_error("%s PNG decode failed: %s" % [label, err])
		return null
	return ImageTexture.create_from_image(image)

static func make_atlas() -> Texture2D:
	return _texture_from_b64(ATLAS_PNG, "Scenery atlas")

static func make_props_sheet() -> Texture2D:
	return _texture_from_b64(PROPS_PNG, "Scenery props")
