extends RefCounted
## Runtime-built polished Delver sheet.
## Stored as palette indices in gzip/base64 so the repository stays text-safe
## and GitHub connector writes cannot corrupt the pixel-art binary.

const WIDTH := 96
const HEIGHT := 136
const INDEX_DATA := ""

const PALETTE: Array[Color] = [Color8(0,0,0,0), Color8(244,218,199,255), Color8(231,194,171,255), Color8(193,152,134,255), Color8(123,132,158,255), Color8(109,100,103,255), Color8(89,82,82,255), Color8(47,88,167,255), Color8(58,70,97,255), Color8(66,61,62,255), Color8(56,56,61,255), Color8(53,53,57,255), Color8(51,50,55,255), Color8(49,50,55,255), Color8(49,48,53,255), Color8(35,54,93,255), Color8(47,48,51,255), Color8(46,45,49,255), Color8(44,44,48,255), Color8(43,43,47,255), Color8(43,40,44,255), Color8(39,40,45,255), Color8(38,39,41,255), Color8(36,37,40,255), Color8(35,35,38,255), Color8(28,36,53,255), Color8(33,33,37,255), Color8(32,33,35,255), Color8(30,31,34,255), Color8(29,30,34,255), Color8(29,29,31,255), Color8(25,29,36,255), Color8(28,26,28,255), Color8(25,25,28,255), Color8(24,25,28,255), Color8(23,23,26,255), Color8(22,23,27,255), Color8(21,22,25,255), Color8(21,20,23,255), Color8(18,20,27,255), Color8(18,19,20,255), Color8(16,17,20,255), Color8(16,16,17,255), Color8(15,15,16,255), Color8(13,14,16,255), Color8(13,12,14,255), Color8(10,13,20,255), Color8(10,10,11,255), Color8(9,9,10,255), Color8(8,8,8,255), Color8(7,7,8,255), Color8(6,7,10,255), Color8(6,6,7,255), Color8(5,5,7,255), Color8(5,5,5,255), Color8(5,4,4,255), Color8(4,4,4,255), Color8(3,3,3,255), Color8(2,2,3,255), Color8(2,2,1,255), Color8(3,1,2,255), Color8(1,1,1,255), Color8(0,0,2,255), Color8(0,1,0,255), Color8(0,0,0,255)]

static func make_sheet() -> Texture2D:
	var packed := Marshalls.base64_to_raw(INDEX_DATA)
	var indices := packed.decompress_dynamic(WIDTH * HEIGHT, FileAccess.COMPRESSION_GZIP)
	if indices.size() != WIDTH * HEIGHT:
		push_error("Delver art decode failed: expected %d pixels, got %d" % [WIDTH * HEIGHT, indices.size()])
		return null
	var image := Image.create(WIDTH, HEIGHT, false, Image.FORMAT_RGBA8)
	var i := 0
	for y in HEIGHT:
		for x in WIDTH:
			var palette_index: int = int(indices[i])
			image.set_pixel(x, y, PALETTE[palette_index])
			i += 1
	return ImageTexture.create_from_image(image)
