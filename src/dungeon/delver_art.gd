extends RefCounted
## Runtime-built polished Delver sheet.
##
## The approved 96x136 indexed PNG is stored as base64 text so GitHub connector
## writes cannot corrupt the binary asset. Godot reconstructs the exact PNG in
## memory and exposes it as a normal Texture2D to the four-direction walk code.

const PNG_DATA := ""

static func make_sheet() -> Texture2D:
	var bytes := Marshalls.base64_to_raw(PNG_DATA)
	if bytes.is_empty():
		push_error("Delver PNG base64 decode failed")
		return null
	var image := Image.new()
	var err := image.load_png_from_buffer(bytes)
	if err != OK:
		push_error("Delver PNG decode failed: %s" % err)
		return null
	if image.get_width() != 96 or image.get_height() != 136:
		push_error("Unexpected Delver sheet size: %dx%d" % [image.get_width(), image.get_height()])
		return null
	return ImageTexture.create_from_image(image)
