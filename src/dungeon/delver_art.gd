static func make_sheet() -> Texture2D:
	if PIXELS.length() != WIDTH * HEIGHT:
		push_error("Delver pixel stream has wrong length: %d" % PIXELS.length())
		return null
	var image := Image.create(WIDTH, HEIGHT, false, Image.FORMAT_RGBA8)
	var i := 0
	for y in HEIGHT:
		for x in WIDTH:
			var palette_index := ALPHABET.find(PIXELS.substr(i, 1))
			if palette_index < 0 or palette_index >= PALETTE.size():
				push_error("Invalid Delver palette token at %d" % i)
				return null
			image.set_pixel(x, y, PALETTE[palette_index])
			i += 1
	return ImageTexture.create_from_image(image)
