extends RefCounted
## Text-safe embedded atlas for the polished NPC population.
## The GitHub connector can corrupt binary PNG uploads, so the validated 80x560
## atlas is stored as base64 text and decoded into an ImageTexture at runtime.

const ATLAS_W := 80
const ATLAS_H := 560
const ATLAS_PNG_B64 := ""


static func make_image() -> Image:
	var bytes: PackedByteArray = Marshalls.base64_to_raw(ATLAS_PNG_B64)
	var image := Image.new()
	var err: Error = image.load_png_from_buffer(bytes)
	if err != OK:
		push_error("Wyrdling: failed to decode embedded polished NPC atlas (%s)" % err)
		return null
	if image.get_width() != ATLAS_W or image.get_height() != ATLAS_H:
		push_error("Wyrdling: embedded NPC atlas has unexpected dimensions")
		return null
	return image


static func make_atlas() -> Texture2D:
	var image := make_image()
	if image == null or image.is_empty():
		return null
	return ImageTexture.create_from_image(image)
